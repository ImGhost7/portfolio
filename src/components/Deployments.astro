---
// 02 · Flagship Deployments: project cards + archive ledger. Everything comes from content.json.
import data from '../data/content.json';
import { amp, fmt, pad, isTodo, live } from '../lib/rich.js';

const cards = live(data.projects);
const archive = data.archive;
const letters = ['a', 'b', 'c', 'd', 'e']; // card positions in the staggered layout

const maxOf = (m) => m.max ?? (m.suffix === '%' ? 100 : m.value <= 1 ? 1 : m.value);
const frac = (m) => Math.min(1, Math.max(0, m.value / maxOf(m)));
const show = (m) => Number(m.value).toFixed(m.decimals ?? 0) + (m.suffix || '');
---

<section id="work" class="sec work" aria-labelledby="work-h" data-sec="02" data-name="Flagship Deployments" data-short="Deployments">
  <div class="sec__head">
    <span class="sec__idx mono"><b>02</b> / 05</span>
    <h2 class="sec__name mono" id="work-h">Flagship Deployments</h2>
    <span class="sec__rule" aria-hidden="true"></span>
    <span class="sec__coord mono" aria-hidden="true">{pad(cards.length)} flagship · {pad(archive.length)} archive</span>
  </div>

  <p class="display work__display" aria-hidden="true">
    <span class="dl dl--1 is-outline" data-parallax="2"><span class="dl__in">Flagship</span></span>
    <span class="dl dl--2" data-parallax="-4"><span class="dl__in">Deployments</span></span>
  </p>

  <p class="deck__hint mono" aria-hidden="true"><b data-deck-idx>01</b> / {pad(cards.length)}<i></i>Swipe</p>

  <div class="deck" data-deck>
    {cards.map((p, i) => {
      const id = `d${i + 1}`;
      const v = p.visual || { type: 'pending', caption: '' };
      return (
        <article
          class={`deploy deploy--${letters[i]}`}
          data-reveal
          style={i % 2 ? '--d:120ms' : undefined}
          data-tilt
          data-cursor="OPEN"
          data-draft={p.draft ? 'needs your details' : undefined}
          aria-labelledby={`${id}-t`}
        >
          <header class="deploy__bar mono"><span>DEP-{pad(i + 1)}</span><span>{p.category}</span></header>

          {v.type === 'profile' ? (
            <div class="deploy__viz deploy__viz--profile" aria-hidden="true">
              <div class="gauge" style={`--p:${(v.gauge.value / 100).toFixed(4)}`}>
                <svg viewBox="0 0 120 120"><circle class="gauge__bg" cx="60" cy="60" r="52" /><circle class="gauge__fg" cx="60" cy="60" r="52" pathLength="100" /></svg>
                <span class="gauge__num"><b class="num" data-to={v.gauge.value} data-dec="0" data-max="100">{v.gauge.value}</b><small>/100</small></span>
                <span class="gauge__cap mono">{v.gauge.label}</span>
              </div>
              <div class="diff mono">
                <p class="diff__r diff__r--old"><i>−</i>{v.before}</p>
                <p class="diff__r diff__r--new"><i>+</i>{v.after}</p>
                <p class="diff__r diff__r--jd">
                  <span>{v.matchLabel}</span>
                  <span class="diff__bar" style={`--jd:${(v.matchValue / 100).toFixed(3)}`}><i></i></span>
                  <span>{v.matchValue}%</span>
                </p>
              </div>
              <span class="deploy__fig mono">{v.caption}</span>
            </div>
          ) : (
            <div class="deploy__viz" aria-hidden="true">
              {v.type === 'pending' ? <span class="slot__plus"></span> : <canvas data-viz={v.type}></canvas>}
              <span class="deploy__fig mono">{v.caption}</span>
            </div>
          )}

          <div class="deploy__body">
            <h3 class="deploy__title display" id={`${id}-t`} set:html={amp(p.title)} />
            {p.subtitle && <p class="deploy__sub" set:html={fmt(p.subtitle)} />}
            {(p.description || []).map((d) => <p class="deploy__desc" set:html={fmt(d)} />)}

            {p.chips && p.chips.length > 0 && (
              <ul class="chips mono" aria-label="Stack">
                {p.chips.map((c) => <li class={isTodo(c) ? 'todo' : undefined}>{c}</li>)}
              </ul>
            )}

            {p.steps && p.steps.length > 0 && (
              <ol class="steps mono" aria-label="What it does">
                {p.steps.map((s, k) => <li><b>{pad(k + 1)}</b>{s}</li>)}
              </ol>
            )}

            {p.metrics && p.metrics.length > 0 && (
              <dl class="metrics">
                {p.metrics.map((m) => (
                  <div class="metric" style={`--p:${frac(m).toFixed(4)}`}>
                    <dt class="mono">{isTodo(m.label) ? <span class="todo">{m.label}</span> : m.label}</dt>
                    <dd class="num" data-to={m.value} data-dec={m.decimals ?? 0} data-suffix={m.suffix} data-max={maxOf(m)}>{show(m)}</dd>
                  </div>
                ))}
              </dl>
            )}

            {p.note && <p class="deploy__note mono">{p.note}</p>}

            {p.links && p.links.length > 0 && (
              <p class="deploy__links mono">
                {p.links.map((l) => (
                  <a class="link" href={l.url} target="_blank" rel="noopener noreferrer">
                    {l.label} <svg class="ico" aria-hidden="true"><use href="#i-ur" /></svg><span class="sr-only">(opens in a new tab)</span>
                  </a>
                ))}
              </p>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <div class="ledger" data-reveal>
    <h3 class="ledger__title mono">Also shipped <span>· archive</span></h3>
    <ul class="ledger__list">
      {archive.map((a) => (
        <li class="ledger__row">
          <span class="ledger__k mono">{a.live && <i class="blip" aria-hidden="true"></i>}{a.when}</span>
          <h4 class="ledger__n">{a.title} <i>{a.kind}</i></h4>
          <p class="ledger__d">
            {a.text}
            {a.link && (
              <>
                {' '}<a class="link" href={a.link.url} target="_blank" rel="noopener noreferrer">{a.link.label}<span class="sr-only"> (opens in a new tab)</span></a>
              </>
            )}
          </p>
          <p class="ledger__s mono">{a.stack}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
