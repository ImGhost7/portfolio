---
// The page shell: <head> (fonts, SEO, social cards), boot flags, and <body>.
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/base.css';
import '../styles/hero.css';
import '../styles/sections.css';
import '../styles/extra.css';
// Hashed URLs of the self-hosted font files, so the browser can start fetching them immediately.
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import grotUrl from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import data from '../data/content.json';

const { site, person } = data;
const { title = site.title, description = site.description, path = '/', noindex = false } = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: Astro.site.href,
  image: ogImage,
  jobTitle: 'AI/ML engineering student and builder',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'St. Francis Institute of Technology, Mumbai' },
  address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressCountry: 'IN' },
  knowsLanguage: ['en', 'hi', 'gu'],
  knowsAbout: ['Machine learning', 'Graph neural networks', 'Natural language processing', 'Full-stack development'],
  sameAs: [person.github.url, person.linkedin.url],
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={person.name} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />

    <!-- link previews (WhatsApp, LinkedIn, Slack, X …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.shortDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.shortDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={grotUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      /* Runs before first paint: JS is available, and respect reduced motion (OS setting or the on-page switch). */
      (function (d) {
        var h = d.documentElement;
        h.className = h.className.replace('no-js', 'js');
        var stored = null;
        try { stored = localStorage.getItem('tb-motion'); } catch (e) {}
        var os = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (stored === 'off' || (stored !== 'on' && os)) h.classList.add('reduced');
      })(document);
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
