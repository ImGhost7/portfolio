---
// Shown after the contact form is sent without JavaScript. (With JavaScript, a message appears inline instead.)
import Base from '../layouts/Base.astro';
import data from '../data/content.json';

const { person } = data;
---

<Base title={`Message sent — ${person.name}`} description="Thanks for getting in touch." path="/thanks/" noindex>
  <div class="grain" aria-hidden="true"></div>
  <main class="solo" id="main">
    <p class="solo__k mono"><i class="blip" aria-hidden="true"></i>Transmission received</p>
    <h1 class="solo__h display">Thank you<span class="amp">.</span></h1>
    <p class="solo__p">Your message has been received. I read everything and reply as soon as I can.</p>
    <p><a class="btn btn--solid" href="/">Back to the portfolio <svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h16M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" /></svg></a></p>
  </main>
</Base>
