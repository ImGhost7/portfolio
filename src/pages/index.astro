---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import About from '../components/About.astro';
import Deployments from '../components/Deployments.astro';
import Matrix from '../components/Matrix.astro';
import Signals from '../components/Signals.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Chrome />
  <main id="main">
    <Hero />
    <Ticker />
    <About />
    <Deployments />
    <Matrix />
    <Signals />
    <Contact />
  </main>
  <Footer />
  <script>
    import '../scripts/main.js';
  </script>
</Base>
